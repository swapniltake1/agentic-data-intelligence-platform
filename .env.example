# Preferred free-tier chat providers. Keep credentials local and uncommitted.
GROQ_API_KEY=
OPENROUTER_KEY=
LLM_PROVIDER_PRIORITY=groq,openrouter,gemini
LLM_FREE_ONLY=true
# Set true only after confirming Gemini's model and account remain on its free tier.
GEMINI_FREE_TIER_CONFIRMED=false

# Optional per-tier model overrides. OpenRouter permits openrouter/free or :free IDs.
# Groq's default model is configurable in case its supported model list changes.
# GROQ_MODEL_LOW=
# GROQ_MODEL_MEDIUM=
# GROQ_MODEL_HIGH=
# OPENROUTER_MODEL_LOW=openrouter/free
# OPENROUTER_MODEL_MEDIUM=openrouter/free
# OPENROUTER_MODEL_HIGH=openrouter/free

# Gemini chat fallback (existing model defaults remain in utils/llm_pick.py).
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_MODEL_LOW=
# GEMINI_MODEL_MEDIUM=
# GEMINI_MODEL_HIGH=

# Gemini embeddings are separate from chat generation.
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
RAG_COLLECTION_NAME=ola_knowledge

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Data directory
CSV_DIR=data
